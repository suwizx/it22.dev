{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "it-kmitl-webring",
  "compatibility_date": "2025-02-14",
  "observability": {
    "enabled": true
  },
  "compatibility_flags": [
    "nodejs_als"
  ],
  "main": ".svelte-kit/cloudflare/_worker.js",
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  "workers_dev": true,
  "preview_urls": true
}
